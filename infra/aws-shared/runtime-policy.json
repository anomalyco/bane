{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow", "Action": "s3:ListBucket", "Resource": "arn:aws:s3:::bane-YOUR_AWS_ACCOUNT_ID-mail-us-east-2",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "us-east-2", "s3:prefix": "staging/"}}
    },
    {
      "Effect": "Allow", "Action": "s3:PutObject", "Resource": "arn:aws:s3:::bane-YOUR_AWS_ACCOUNT_ID-mail-us-east-2/quarantine/?*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "us-east-2"}}
    },
    {
      "Effect": "Allow", "Action": ["s3:PutObject", "s3:AbortMultipartUpload"], "Resource": "arn:aws:s3:::bane-YOUR_AWS_ACCOUNT_ID-mail-us-east-2/workspaces/ws_????????????????????????????????/raw/?*.eml",
      "Condition": {"StringEquals": {"aws:RequestedRegion": "us-east-2"}, "Null": {"s3:RequestObjectTagKeys": "true"}}
    },
    {
      "Effect": "Deny", "Action": ["sns:*Topic*", "sns:*Tag*", "sns:Subscribe", "ses:*Identity*", "ses:*Tenant*", "ses:*ConfigurationSet*", "ses:TagResource", "ses:SendEmail", "ses:*Reputation*"],
      "NotResource": ["arn:aws:ses:us-east-1:YOUR_AWS_ACCOUNT_ID:*", "arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:*", "arn:aws:sns:us-east-1:YOUR_AWS_ACCOUNT_ID:*", "arn:aws:sns:us-east-2:YOUR_AWS_ACCOUNT_ID:*", "arn:aws:ses:us-east-1:aws:reputation-policy/strict", "arn:aws:ses:us-east-2:aws:reputation-policy/strict"]
    },
    {
      "Effect": "Deny", "NotAction": "sts:AssumeRole", "Resource": "*",
      "Condition": {"StringNotEquals": {"aws:RequestedRegion": ["us-east-1", "us-east-2"]}}
    },
    {
      "Effect": "Deny", "Action": ["s3:*", "ses:*ReceiptRule*"], "Resource": "*",
      "Condition": {"StringNotEquals": {"aws:RequestedRegion": "us-east-2"}}
    },
    {
      "Effect": "Deny", "NotAction": "ses:SendEmail", "Resource": "arn:aws:ses:*:*:identity/*@*"
    },
    {
      "Effect": "Allow", "Action": "ses:GetEmailIdentity", "Resource": "arn:aws:ses:us-east-1:YOUR_AWS_ACCOUNT_ID:identity/?*.??*"
    },
    {
      "Effect": "Allow", "Action": "ses:CreateEmailIdentity", "Resource": ["arn:aws:ses:us-east-1:YOUR_AWS_ACCOUNT_ID:identity/?*.??*", "arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:identity/?*.??*"],
      "Condition": {
        "StringLike": {"aws:RequestTag/bane:domain-claim": "????????-????-4???-????-????????????"},
        "StringEquals": {"aws:RequestTag/bane:owner": "bane", "aws:RequestTag/bane:installation-id": "bane:pool", "aws:RequestTag/bane:purpose": "domain-identity"},
        "ForAllValues:StringEquals": {"aws:TagKeys": ["bane:domain-claim", "bane:owner", "bane:installation-id", "bane:purpose"]}
      }
    },
    {
      "Effect": "Allow", "Action": "ses:TagResource", "Resource": ["arn:aws:ses:us-east-1:YOUR_AWS_ACCOUNT_ID:identity/?*.??*", "arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:identity/?*.??*"],
      "Condition": {
        "StringLike": {"aws:ResourceTag/bane:domain-claim": "????????-????-4???-????-????????????"},
        "StringEquals": {"aws:RequestTag/bane:domain-claim": "${aws:ResourceTag/bane:domain-claim}", "aws:ResourceTag/bane:owner": "bane", "aws:ResourceTag/bane:installation-id": "bane:pool", "aws:ResourceTag/bane:purpose": "domain-identity", "aws:RequestTag/bane:owner": "bane", "aws:RequestTag/bane:installation-id": "bane:pool", "aws:RequestTag/bane:purpose": "domain-identity"},
        "ForAllValues:StringEquals": {"aws:TagKeys": ["bane:domain-claim", "bane:owner", "bane:installation-id", "bane:purpose"]}
      }
    },
    {
      "Effect": "Allow", "Action": ["ses:PutEmailIdentityMailFromAttributes", "ses:DeleteEmailIdentity", "ses:CreateTenantResourceAssociation", "ses:DeleteTenantResourceAssociation", "ses:ListResourceTenants"],
      "Resource": "arn:aws:ses:us-east-1:YOUR_AWS_ACCOUNT_ID:identity/?*.??*",
      "Condition": {
        "StringLike": {"aws:ResourceTag/bane:domain-claim": "????????-????-4???-????-????????????"},
        "StringEquals": {"aws:ResourceTag/bane:owner": "bane", "aws:ResourceTag/bane:installation-id": "bane:pool", "aws:ResourceTag/bane:purpose": "domain-identity"}
      }
    }
  ]
}
