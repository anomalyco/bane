{
  "Version": "2012-10-17",
  "Statement": [
    {"Sid":"Reads","Effect":"Allow","Action":["ses:GetAccount","cloudwatch:GetMetricData"],"Resource":"*","Condition":{"StringEquals":{"aws:RequestedRegion":["us-east-1","us-east-2"]}}},
    {"Sid":"ReceiptRead","Effect":"Allow","Action":"ses:DescribeActiveReceiptRuleSet","Resource":"*","Condition":{"StringEquals":{"aws:RequestedRegion":"us-east-2"}}},
    {"Sid":"Tracking","Effect":"Allow","Action":"ses:ApplyTrackingConfigurationOverrides","Resource":"*","Condition":{"StringEquals":{"ses:OpenTrackingEnabled":"${ses:ClickTrackingEnabled}","aws:RequestedRegion":["us-east-1","us-east-2"]}}},
    {"Sid":"CustomerRoles","Effect":"Allow","Action":"sts:AssumeRole","Resource":"arn:aws:iam::*:role/Bane-????????????????????","Condition":{"StringEquals":{"sts:RoleSessionName":"Bane"},"StringNotEquals":{"aws:ResourceAccount":"YOUR_AWS_ACCOUNT_ID"}}},
    {"Sid":"IdentityAndTenantLifecycle","Effect":"Allow","Action":["ses:CreateEmailIdentity","ses:DeleteEmailIdentity","ses:GetEmailIdentity","ses:PutEmailIdentityMailFromAttributes","ses:ListResourceTenants","ses:TagResource","ses:CreateTenant","ses:GetTenant","ses:PutTenantSuppressionAttributes","ses:UpdateReputationEntityPolicy","ses:UpdateReputationEntityCustomerManagedStatus"],"Resource":["arn:aws:ses:us-east-?:YOUR_AWS_ACCOUNT_ID:identity/?*.??*","arn:aws:ses:us-east-?:YOUR_AWS_ACCOUNT_ID:tenant/bane-*ws_????????????????????????????????/*","arn:aws:ses:us-east-?:aws:reputation-policy/strict"]},
    {"Sid":"TenantAssociationsAndSetReads","Effect":"Allow","Action":["ses:CreateTenantResourceAssociation","ses:DeleteTenantResourceAssociation","ses:GetConfigurationSet","ses:GetConfigurationSetEventDestinations"],"Resource":["arn:aws:ses:us-east-?:YOUR_AWS_ACCOUNT_ID:identity/?*.??*","arn:aws:ses:us-east-?:YOUR_AWS_ACCOUNT_ID:tenant/bane-*ws_????????????????????????????????/*","arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:configuration-set/bane-transactional","arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:configuration-set/bane-marketing","arn:aws:ses:us-east-1:YOUR_AWS_ACCOUNT_ID:configuration-set/bane-trusted-transactional","arn:aws:ses:us-east-1:YOUR_AWS_ACCOUNT_ID:configuration-set/bane-trusted-marketing"]},
    {"Sid":"OhioSend","Effect":"Allow","Action":"ses:SendEmail","Resource":["arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:identity/*","arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:configuration-set/bane-transactional","arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:configuration-set/bane-marketing"],"Condition":{"StringLike":{"ses:TenantName":["bane-ws_????????????????????????????????","bane-probation-ws_????????????????????????????????"]},"Null":{"ses:MultiRegionEndpointId":"true"}}},
    {"Sid":"TrustedSend","Effect":"Allow","Action":"ses:SendEmail","Resource":["arn:aws:ses:us-east-1:YOUR_AWS_ACCOUNT_ID:identity/?*.??*","arn:aws:ses:us-east-1:YOUR_AWS_ACCOUNT_ID:configuration-set/bane-trusted-transactional","arn:aws:ses:us-east-1:YOUR_AWS_ACCOUNT_ID:configuration-set/bane-trusted-marketing"],"Condition":{"StringLike":{"ses:TenantName":"bane-trusted-ws_????????????????????????????????"},"StringEquals":{"ses:ApiVersion":"2"},"Null":{"ses:MultiRegionEndpointId":"true"}}},
    {"Sid":"TopicReads","Effect":"Allow","Action":["sns:GetTopicAttributes","sns:ListTagsForResource","sns:ListSubscriptionsByTopic","sns:GetSubscriptionAttributes"],"Resource":["arn:aws:sns:us-east-2:YOUR_AWS_ACCOUNT_ID:bane-inbound","arn:aws:sns:us-east-2:YOUR_AWS_ACCOUNT_ID:bane-feedback","arn:aws:sns:us-east-1:YOUR_AWS_ACCOUNT_ID:bane-trusted-feedback"]},
    {"Sid":"FeedbackSubscription","Effect":"Allow","Action":"sns:Subscribe","Resource":["arn:aws:sns:us-east-2:YOUR_AWS_ACCOUNT_ID:bane-feedback","arn:aws:sns:us-east-1:YOUR_AWS_ACCOUNT_ID:bane-trusted-feedback"],"Condition":{"StringEquals":{"sns:Protocol":"https","sns:Endpoint":"YOUR_STAGE_ORIGIN/v1/events/ses"}}},
    {"Sid":"BucketReads","Effect":"Allow","Action":["s3:GetBucketPolicy","s3:GetBucketPublicAccessBlock","s3:GetLifecycleConfiguration"],"Resource":"arn:aws:s3:::bane-YOUR_AWS_ACCOUNT_ID-mail-us-east-2"},
    {"Sid":"StagingList","Effect":"Allow","Action":"s3:ListBucket","Resource":"arn:aws:s3:::bane-YOUR_AWS_ACCOUNT_ID-mail-us-east-2","Condition":{"StringEquals":{"s3:prefix":"staging/"}}},
    {"Effect":"Allow","Action":"s3:GetObject","Resource":"arn:aws:s3:::bane-YOUR_AWS_ACCOUNT_ID-mail-us-east-2/staging/?*"},
    {"Effect":"Allow","Action":"s3:PutObject","Resource":"arn:aws:s3:::bane-YOUR_AWS_ACCOUNT_ID-mail-us-east-2/quarantine/?*"},
    {"Sid":"WorkspaceMail","Effect":"Allow","Action":["s3:GetObject","s3:PutObject","s3:PutObjectTagging","s3:AbortMultipartUpload"],"Resource":["arn:aws:s3:::bane-YOUR_AWS_ACCOUNT_ID-mail-us-east-2/workspaces/ws_????????????????????????????????/raw/?*.eml","arn:aws:s3:::bane-YOUR_AWS_ACCOUNT_ID-mail-us-east-2/workspaces/ws_????????????????????????????????/att/msg_????????????????????????????????/*"]},
    {"Sid":"Regions","Effect":"Deny","NotAction":"sts:AssumeRole","Resource":"*","Condition":{"StringNotEquals":{"aws:RequestedRegion":["us-east-1","us-east-2"]}}},
    {"Sid":"OhioMailOnly","Effect":"Deny","Action":["s3:*","ses:*ReceiptRule*"],"Resource":"*","Condition":{"StringNotEquals":{"aws:RequestedRegion":"us-east-2"}}},
    {"Sid":"OwnObjects","Effect":"Deny","Action":["s3:GetObject","s3:Put*","s3:ListBucket","s3:AbortMultipartUpload"],"Resource":"*","Condition":{"StringNotEquals":{"s3:ResourceAccount":"YOUR_AWS_ACCOUNT_ID"}}},
    {"Sid":"DomainIdentities","Effect":"Deny","NotAction":"ses:SendEmail","Resource":"arn:aws:ses:*:*:identity/*@*"},
    {"Effect":"Deny","NotAction":["ses:GetEmailIdentity","ses:CreateEmailIdentity","ses:SendEmail"],"Resource":"arn:aws:ses:us-east-?:YOUR_AWS_ACCOUNT_ID:identity/*","Condition":{"StringNotLike":{"aws:ResourceTag/bane:domain-claim":"????????-????-4???-????-????????????"}}},
    {"Sid":"OperatorMailControls","Effect":"Deny","Action":["s3:PutBucket*","s3:DeleteBucketPolicy","s3:PutLifecycleConfiguration","sns:CreateTopic","sns:Set*Attributes","sns:AddPermission","sns:RemovePermission","ses:*IdentityPolic*","ses:CreateReceiptRule*","ses:UpdateReceiptRule","ses:DeleteReceiptRule*","ses:SetActiveReceiptRuleSet","ses:SetReceiptRulePosition","ses:ReorderReceiptRuleSet","ses:CreateConfigurationSet*","ses:UpdateConfigurationSetEventDestination","ses:DeleteConfigurationSetEventDestination","ses:PutConfigurationSetSuppressionOptions"],"Resource":"*"}
  ]
}
