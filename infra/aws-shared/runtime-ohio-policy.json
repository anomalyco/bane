{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow", "Action": ["ses:GetAccount", "cloudwatch:GetMetricData"], "Resource": "*",
      "Condition": {"StringEquals": {"aws:RequestedRegion": ["us-east-1", "us-east-2"]}}
    },
    {
      "Effect": "Allow", "Action": "ses:ApplyTrackingConfigurationOverrides", "Resource": "*",
      "Condition": {"StringEquals": {"ses:OpenTrackingEnabled": "${ses:ClickTrackingEnabled}", "aws:RequestedRegion": ["us-east-1", "us-east-2"]}}
    },
    {
      "Effect": "Allow", "Action": "sts:AssumeRole", "Resource": "arn:aws:iam::*:role/Bane-????????????????????",
      "Condition": {"StringEquals": {"sts:RoleSessionName": "Bane"}, "StringNotEquals": {"aws:ResourceAccount": "YOUR_AWS_ACCOUNT_ID"}}
    },
    {
      "Effect": "Allow", "Resource": "*",
      "Action": "ses:DescribeActiveReceiptRuleSet",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "us-east-2" } }
    },
    {
      "Effect": "Allow", "Action": "ses:SendEmail",
      "Resource": ["arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:identity/*", "arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:configuration-set/bane-transactional", "arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:configuration-set/bane-marketing"],
      "Condition": { "StringLike": { "ses:TenantName": ["bane-ws_????????????????????????????????", "bane-probation-ws_????????????????????????????????"] }, "Null": { "ses:MultiRegionEndpointId": "true" } }
    },
    {
      "Effect": "Allow", "Action": ["ses:DeleteEmailIdentity", "ses:PutEmailIdentityMailFromAttributes", "ses:CreateTenantResourceAssociation", "ses:DeleteTenantResourceAssociation", "ses:ListResourceTenants"],
      "Resource": "arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:identity/?*.??*",
      "Condition": { "StringLike": { "aws:ResourceTag/bane:domain-claim": "????????-????-4???-????-????????????" } }
    },
    {
      "Effect": "Allow",
      "Action": [
        "ses:CreateTenantResourceAssociation",
        "ses:GetConfigurationSet", "ses:GetConfigurationSetEventDestinations",
        "sns:ListTagsForResource", "sns:GetTopicAttributes", "sns:ListSubscriptionsByTopic"
      ],
      "Resource": [
        "arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:configuration-set/bane-transactional",
        "arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:configuration-set/bane-marketing",
        "arn:aws:sns:us-east-2:YOUR_AWS_ACCOUNT_ID:bane-feedback", "arn:aws:sns:us-east-2:YOUR_AWS_ACCOUNT_ID:bane-inbound"
      ]
    },
    {
      "Effect": "Allow", "Action": "sns:GetSubscriptionAttributes",
      "Resource": ["arn:aws:sns:us-east-2:YOUR_AWS_ACCOUNT_ID:bane-feedback", "arn:aws:sns:us-east-2:YOUR_AWS_ACCOUNT_ID:bane-inbound"]
    },
    {
      "Effect": "Allow", "Action": "sns:Subscribe",
      "Resource": "arn:aws:sns:us-east-2:YOUR_AWS_ACCOUNT_ID:bane-feedback",
      "Condition": { "StringEquals": { "sns:Protocol": "https", "sns:Endpoint": "https://bane.mx/v1/events/ses" } }
    },
    {
      "Effect": "Allow", "Action": ["s3:GetBucketPolicy", "s3:GetBucketPublicAccessBlock", "s3:GetLifecycleConfiguration"], "Resource": "arn:aws:s3:::bane-YOUR_AWS_ACCOUNT_ID-mail-us-east-2",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "us-east-2", "s3:ResourceAccount": "YOUR_AWS_ACCOUNT_ID" } }
    },
    {
      "Effect": "Deny", "Action": ["s3:GetObject", "s3:Put*", "s3:ListBucket", "s3:AbortMultipartUpload"], "Resource": "*",
      "Condition": { "StringNotEquals": { "s3:ResourceAccount": "YOUR_AWS_ACCOUNT_ID" } }
    },
    {
      "Effect": "Allow", "Action": ["s3:GetObject", "ses:GetEmailIdentity"],
      "Condition": {"StringEquals": {"aws:RequestedRegion": "us-east-2"}},
      "Resource": [
        "arn:aws:s3:::bane-YOUR_AWS_ACCOUNT_ID-mail-us-east-2/staging/?*",
        "arn:aws:s3:::bane-YOUR_AWS_ACCOUNT_ID-mail-us-east-2/workspaces/ws_????????????????????????????????/raw/?*.eml",
        "arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:identity/?*.??*"
      ]
    },
    {
      "Effect": "Allow", "Action": [
        "s3:GetObject", "s3:PutObject", "ses:CreateTenantResourceAssociation", "ses:GetTenant",
        "ses:PutTenantSuppressionAttributes", "ses:UpdateReputationEntityPolicy", "ses:DeleteTenantResourceAssociation"
      ],
      "Resource": [
        "arn:aws:s3:::bane-YOUR_AWS_ACCOUNT_ID-mail-us-east-2/workspaces/ws_????????????????????????????????/att/msg_????????????????????????????????/matt_????????????????????????????????",
        "arn:aws:s3:::bane-YOUR_AWS_ACCOUNT_ID-mail-us-east-2/workspaces/ws_????????????????????????????????/att/msg_????????????????????????????????/????????????????????????????????????????????????????????????????/matt_????????????????????????????????",
        "arn:aws:ses:us-east-2:YOUR_AWS_ACCOUNT_ID:tenant/bane-ws_????????????????????????????????/*", "arn:aws:ses:us-east-2:aws:reputation-policy/strict"
      ], "Condition": {"StringEquals": {"aws:RequestedRegion": "us-east-2"}}
    },
    {
      "Effect": "Allow", "Action": ["s3:PutObject", "s3:PutObjectTagging"],
      "Resource": "arn:aws:s3:::bane-YOUR_AWS_ACCOUNT_ID-mail-us-east-2/workspaces/ws_????????????????????????????????/raw/?*.eml",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "us-east-2", "s3:RequestObjectTag/bane-kind": "raw" }, "ForAllValues:StringEquals": { "s3:RequestObjectTagKeys": "bane-kind" } }
    }
  ]
}
