{
  "name": "bane-support",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --config wrangler.dev.jsonc",
    "check": "tsc --noEmit",
    "build": "wrangler deploy --config wrangler.dev.jsonc --dry-run --outdir dist",
    "test": "bun run build && vitest run",
    "migrate:dev": "wrangler d1 migrations apply bane-support-dev --remote --config wrangler.dev.jsonc",
    "migrate:production": "wrangler d1 migrations apply bane-support --remote --config wrangler.prod.jsonc"
  },
  "dependencies": {
    "@opencode/plugin": "2.2.7",
    "@opencode/sdk": "2.2.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261112.1",
    "miniflare": "5.20261110.2-beta",
    "typescript": "^6.0.3",
    "vitest": "~4.1.0",
    "wrangler": "^4.161.0"
  }
}
