{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DiscoverAccountAndSesIdentities",
      "Effect": "Allow",
      "Action": ["sts:GetCallerIdentity", "ses:GetAccount", "ses:ListEmailIdentities"],
      "Resource": "*"
    },
    {
      "Sid": "ReadSesReputationMetrics",
      "Effect": "Allow",
      "Action": "cloudwatch:GetMetricData",
      "Resource": "*"
    },
    {
      "Sid": "ManageSenderIdentities",
      "Effect": "Allow",
      "Action": [
        "ses:GetEmailIdentity",
        "ses:CreateEmailIdentity",
        "ses:PutEmailIdentityMailFromAttributes"
      ],
      "Resource": "arn:aws:ses:*:YOUR_AWS_ACCOUNT_ID:identity/*"
    },
    {
      "Sid": "ProvisionBaneConfigurationSets",
      "Effect": "Allow",
      "Action": [
        "ses:CreateConfigurationSet",
        "ses:GetConfigurationSet",
        "ses:GetConfigurationSetEventDestinations",
        "ses:CreateConfigurationSetEventDestination",
        "ses:UpdateConfigurationSetEventDestination",
        "ses:PutConfigurationSetSuppressionOptions",
        "ses:TagResource"
      ],
      "Resource": "arn:aws:ses:*:YOUR_AWS_ACCOUNT_ID:configuration-set/bane-*"
    },
    {
      "Sid": "SendFromAccountIdentities",
      "Effect": "Allow",
      "Action": "ses:SendEmail",
      "Resource": [
        "arn:aws:ses:*:YOUR_AWS_ACCOUNT_ID:identity/?*.??*",
        "arn:aws:ses:*:YOUR_AWS_ACCOUNT_ID:configuration-set/bane-*",
        "arn:aws:ses:*:YOUR_AWS_ACCOUNT_ID:template/*"
      ],
      "Condition": {"StringEquals": {"ses:ApiVersion": "2"}}
    },
    {
      "Sid": "ApplyPerMessageTracking",
      "Effect": "Allow",
      "Action": "ses:ApplyTrackingConfigurationOverrides",
      "Resource": "*"
    },
    {
      "Sid": "ReadAndRenderStoredTemplates",
      "Effect": "Allow",
      "Action": ["ses:GetEmailTemplate", "ses:TestRenderEmailTemplate"],
      "Resource": "arn:aws:ses:*:YOUR_AWS_ACCOUNT_ID:template/*"
    },
    {
      "Sid": "ManageMailboxReceiptRules",
      "Effect": "Allow",
      "Action": [
        "ses:DescribeActiveReceiptRuleSet",
        "ses:DescribeReceiptRuleSet",
        "ses:CreateReceiptRuleSet",
        "ses:SetActiveReceiptRuleSet",
        "ses:CreateReceiptRule",
        "ses:UpdateReceiptRule",
        "ses:DeleteReceiptRule"
      ],
      "Resource": "*"
    },
    {
      "Sid": "ProvisionMailboxBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:CreateBucket",
        "s3:ListBucket",
        "s3:PutBucketOwnershipControls",
        "s3:PutBucketTagging",
        "s3:PutBucketPublicAccessBlock",
        "s3:PutBucketPolicy",
        "s3:PutLifecycleConfiguration"
      ],
      "Resource": "arn:aws:s3:::bane-*-mail-*"
    },
    {
      "Sid": "ReadWriteMailboxObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:PutObjectTagging"],
      "Resource": "arn:aws:s3:::bane-*-mail-*/*",
      "Condition": {"StringEquals": {"s3:ResourceAccount": "YOUR_AWS_ACCOUNT_ID"}}
    },
    {
      "Sid": "ProvisionBaneFeedbackTopics",
      "Effect": "Allow",
      "Action": [
        "sns:CreateTopic",
        "sns:GetTopicAttributes",
        "sns:SetTopicAttributes",
        "sns:ListTagsForResource",
        "sns:TagResource",
        "sns:ListSubscriptionsByTopic",
        "sns:GetSubscriptionAttributes",
        "sns:SetSubscriptionAttributes"
      ],
      "Resource": "arn:aws:sns:*:YOUR_AWS_ACCOUNT_ID:bane-*"
    },
    {
      "Sid": "SubscribeBaneHttpsFeedback",
      "Effect": "Allow",
      "Action": "sns:Subscribe",
      "Resource": "arn:aws:sns:*:YOUR_AWS_ACCOUNT_ID:bane-*",
      "Condition": {
        "StringEquals": {"sns:Protocol": "https"},
        "StringLike": {"sns:Endpoint": "https://*/v1/events/ses"}
      }
    }
  ]
}
