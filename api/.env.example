# Copy to .env; fill locally and never commit secrets.
# Docker dashboard + API origin. For Vite development use http://127.0.0.1:5173.
PUBLIC_URL=http://127.0.0.1:8793
# Optional public SNS callback while dashboard/OIDC login remains local.
# Example: https://YOUR-TUNNEL/v1/events/ses
SES_FEEDBACK_URL=
# Root secret: generate at least 32 random bytes (for example 64 hex characters).
BANE_ROOT_SECRET=
ACCOUNT_ISSUER=https://account.anoma.ly
ACCOUNT_CLIENT_ID=
ACCOUNT_CLIENT_PRIVATE_KEY=
# Issuer's ID token algorithm; the confidential client assertion uses ES256.
ACCOUNT_ID_TOKEN_ALG=ES256
# Exact authentication context required for dashboard sessions and MCP tokens; empty means none.
ACCOUNT_REQUIRED_ACR=
# Comma-separated exact issuer subjects (sub) allowed to use this installation; never addresses.
# After someone's first, refused sign-in: node --import tsx scripts/list-signin-attempts.ts
AUTH_ALLOWED_SUBJECTS=
# Optional only during rotation; not a fallback for old login sessions.
# PREVIOUS_BANE_ROOT_SECRET=

# Local Postgres: use the same generated password in both values.
POSTGRES_PASSWORD=
DATABASE_URL=postgres://bane:REPLACE_PASSWORD@127.0.0.1:55432/bane
PORT=8793
HOST=127.0.0.1
# Direct API origin for local acceptance, not the browser/OIDC callback origin.
API_BASE_URL=http://127.0.0.1:8793

# Simulate all sending until live SES and its AWS credentials are configured.
# SES discovery and provisioning are disabled while sending is simulated.
ENABLE_LIVE_SES=false
# Simulated sends use the full SES dispatch path with an in-process transport.
# These optional values default to 100 ms, 1,000 recipients/s, and 250 ms.
# SIMULATED_SES_LATENCY_MS=100
# SIMULATED_SES_RATE=1000
# SIMULATED_SES_DELIVERY_DELAY_MS=250
# Seeds the database default once during migration; manage regions through the API afterward.
DEFAULT_SES_REGION=us-east-1
# Explicit server-only IAM credentials; no automatic role lookup or temporary-token renewal.
# Keep keys out of the UI. Account/topic trust and configuration-set names are derived, not env inputs.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional for temporary credentials.
AWS_SESSION_TOKEN=
# AWS provisioning requires a public HTTPS PUBLIC_URL (use a tunnel/public host locally).
# Update the OIDC OAuth origin and callback to match; localhost/127.0.0.1 cannot receive SNS.

# Private bucket. MinIO uses these credentials locally; provision the bucket once.
S3_BUCKET=bane-attachments
S3_REGION=us-east-1
S3_ENDPOINT=http://127.0.0.1:59000
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
