// Bane dev (dev.bane.mx): a full copy of the hosted installation with its own Worker, database,
// queues, bucket and AWS account (905840579680). Its resources were created by hand with the
// names below; deploy with `wrangler deploy --config wrangler.dev.jsonc`.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bane-dev",
  "account_id": "d8e944f537ceef3f06a5bd3aec1d7a53",
  "workers_dev": false,
  "routes": [{ "pattern": "dev.bane.mx", "custom_domain": true }],
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["nodejs_compat"],
  "alias": { "@aws-sdk/xml-builder": "@aws-sdk/xml-builder/dist-cjs/index.js" },
  "assets": {
    "directory": "../app/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/v1", "/v1/*", "/api", "/api/*", "/mcp", "/mcp/*", "/.well-known", "/.well-known/*", "/unsubscribe", "/unsubscribe/*", "/health", "/health/*", "/internal/*", "/openapi.json", "/docs.md", "/docs/operations/*", "/llms.txt"]
  },
  "vars": {
    "BANE_MAIL_BUCKET": "bane-dev-mail",
    "BANE_MAIL_STORE": "r2",
    "PUBLIC_URL": "https://dev.bane.mx",
    "ACCOUNT_ISSUER": "https://account.dev.anoma.ly",
    "ACCOUNT_REQUIRED_ACR": "urn:anomaly:acr:google",
    "ACCOUNT_CLIENT_ID": "bane-dev",
    "MULTI_TENANT": "true",
    "BANE_PLATFORM_AWS_ACCOUNT": "905840579680",
    // The dedicated account only has the v8 policies: tenants and identities must be created with their pool tags.
    "BANE_REGIONAL_SENDING": "true",
    "BANE_TRUSTED_POOL": "true",
    "BANE_REQUIRE_DMARC_FOR_BULK": "true",
    "BANE_HOSTED_SCREEN": "true",
    "BANE_RECEIVING_REDRIVE": "true",
    // Dev only: the pools become ready in the SES sandbox, so dev can send to the mailbox simulator and verified addresses.
    "BANE_ALLOW_SES_SANDBOX": "true",
    "HOSTED_SEND_CAP_FIRST_WEEK": "100",
    "HOSTED_SEND_CAP_SECOND_WEEK": "1000",
    "HOSTED_SEND_CAP_MATURE": "10000",
    "DEFAULT_SES_REGION": "us-east-2",
    // Live SES uses the shared-account key (infra/aws-shared). Sends stay denied by its IAM policy
    // until every send carries an SES TenantName.
    "ENABLE_LIVE_SES": "true",
    "JOB_CONCURRENCY": "6",
    "SIMULATED_SES_LATENCY_MS": "170",
    "SIMULATED_SES_RATE": "5000",
    "DISPATCH_SHARDS": "4",
    "DISPATCH_RATE_FACTOR": "1.1",
    "API_RATE_LIMIT_PER_MINUTE": "10000",
    "WORK_QUEUE_NAME": "bane-dev-work",
    "WEBHOOK_QUEUE_NAME": "bane-dev-webhooks",
    "FEEDBACK_QUEUE_NAME": "bane-dev-feedback"
  },
  "durable_objects": { "bindings": [{ "name": "DISPATCHER", "class_name": "DispatcherShard" }] },
  // Run HTTP requests next to the bane-dev database (PlanetScale aws-us-east-2).
  "placement": { "region": "aws:us-east-2" },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DispatcherShard"] }],
  // Hyperdrive config `bane-dev` in anomaly-dev (caching disabled, 10 origin connections). The database allows 25 (22
  // for non-superusers), and Hyperdrive can open a second pool with its own allocation, so two pools must fit: at 15,
  // a second pool exhausted the database and Postgres refused connections mid-E2E (2026-11-11).
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "8c45a6d9fd9c48af94fd30baf40410fd" }],
  "browser": { "binding": "BROWSER" },
  "r2_buckets": [{ "binding": "ATTACHMENTS", "bucket_name": "bane-dev-attachments" }, { "binding": "MAIL", "bucket_name": "bane-dev-mail" }],
  "queues": {
    "producers": [
      { "binding": "WAKE_QUEUE", "queue": "bane-dev-work" },
      { "binding": "WEBHOOK_QUEUE", "queue": "bane-dev-webhooks" },
      { "binding": "FEEDBACK_DLQ", "queue": "bane-dev-feedback-dlq" },
      { "binding": "FEEDBACK_QUEUE", "queue": "bane-dev-feedback" }
    ],
    "consumers": [
      // Wake messages are hints, not jobs: drain Postgres once for hints already waiting together.
      { "queue": "bane-dev-work", "max_batch_size": 1, "max_batch_timeout": 0, "max_retries": 3, "max_concurrency": 8 },
      // Start an idle callback immediately; arrivals during its DB round trip form the next batch.
      { "queue": "bane-dev-webhooks", "max_batch_size": 8, "max_batch_timeout": 0, "max_retries": 3, "max_concurrency": 2 },
      { "queue": "bane-dev-feedback", "max_batch_size": 100, "max_batch_timeout": 0, "max_retries": 5, "max_concurrency": 1, "dead_letter_queue": "bane-dev-feedback-dlq" }
    ]
  },
  "triggers": { "crons": ["* * * * *", "7 * * * *"] },
  // Rate limiter namespaces are per account; these are unused in anomaly-dev.
  "ratelimits": [
    { "name": "ADMISSION", "namespace_id": "8794001", "simple": { "limit": 6000, "period": 60 } },
    { "name": "SNS_CERT_MISSES", "namespace_id": "8794002", "simple": { "limit": 60, "period": 60 } }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
