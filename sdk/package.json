{
  "name": "@banemx/sdk",
  "version": "0.4.1",
  "description": "TypeScript SDK for the Bane email API",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "bane": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./webhooks": {
      "types": "./dist/webhooks.d.ts",
      "import": "./dist/webhooks.js"
    },
    "./upload": {
      "types": "./dist/upload.d.ts",
      "import": "./dist/upload.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/bane.git",
    "directory": "sdk"
  },
  "homepage": "https://github.com/anomalyco/bane/tree/dev/sdk#readme",
  "bugs": {
    "url": "https://github.com/anomalyco/bane/issues"
  },
  "keywords": [
    "bane",
    "email",
    "ses",
    "sdk",
    "typescript",
    "self-hosted"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^26.5.0",
    "typescript": "^6.0.3"
  }
}
